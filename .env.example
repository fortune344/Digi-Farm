# Digi-Farm — variables d'environnement (NE PAS mettre de vraies valeurs ici).
# Copier ce fichier en .env.local et remplir.

# --- Base de données ---
# Chemin du fichier SQLite local.
DATABASE_URL=./data/digifarm.db

# --- Authentification ---
# Secret long et aléatoire pour signer les sessions/cookies.
# Générer par ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Agrégateur de paiement (Phase 4 — voir docs/blueprints/paiement.md) ---
# À remplir une fois l'agrégateur choisi (CinetPay / FedaPay / Hub2).
# PAYMENT_API_KEY=
# PAYMENT_API_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# =============================================================================
# Version Django (dossier digifarm/) — les variables ci-dessus concernent
# l'ancienne app Next, conservée en référence le temps de la réécriture.
# =============================================================================

# --- Django ---
# Secret de signature des sessions et des jetons CSRF. OBLIGATOIRE hors dev.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Mettre à 0 en production (active HSTS, cookies sécurisés, redirection HTTPS).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Forcer les cookies en HTTPS uniquement (par défaut : l'inverse de DEBUG).
# DJANGO_COOKIE_SECURE=1

# --- Agrégateur de paiement ---
# Secret de vérification de la signature HMAC des webhooks.
# OBLIGATOIRE hors dev ; une valeur de développement est utilisée si absente.
PAYMENT_WEBHOOK_SECRET=

# --- Photos ---
# Dossier de stockage des photos d'annonces (défaut : <dépôt>/media).
# DIGIFARM_MEDIA_ROOT=
