{
  "name": "digi-farm-outils",
  "version": "0.1.0",
  "private": true,
  "description": "Outils front de Digi-Farm : compilation Tailwind et extraction des icones. L'application, elle, est en Django (dossier digifarm/).",
  "scripts": {
    "css:build": "tailwindcss -i digifarm/static/src/input.css -o digifarm/static/css/site.css --minify",
    "css:watch": "tailwindcss -i digifarm/static/src/input.css -o digifarm/static/css/site.css --watch",
    "icones": "node scripts/extraire-icones.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "lucide-react": "1.17.0",
    "tailwindcss": "4.3.0"
  }
}
