{
  "name": "digi-farm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-demo.cjs",
    "test:webhook": "node scripts/test-webhook.cjs",
    "css:build": "tailwindcss -i digifarm/static/src/input.css -o digifarm/static/css/site.css --minify",
    "css:watch": "tailwindcss -i digifarm/static/src/input.css -o digifarm/static/css/site.css --watch",
    "icones": "node scripts/extraire-icones.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/cli": "4.3.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.41",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
